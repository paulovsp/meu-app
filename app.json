{
  "expo": {
    "name": "Dr.Sig",
    "slug": "meu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.drsig.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSFaceIDUsageDescription": "Usado pra entrar no Dr.Sig com Face ID, sem precisar digitar e-mail e senha."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#497363"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "br.com.drsig.app",
      "versionCode": 17
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#497363"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usado pra selecionar uma foto da galeria e ler o texto dela.",
          "cameraPermission": "Usado pra fotografar um documento e ler o texto dele."
        }
      ],
      "./plugins/withForegroundServiceMicrophone",
      "./plugins/withoutForegroundServiceMediaPlayback"
    ],
    "extra": {
      "eas": {
        "projectId": "d716169f-7f0f-411b-8b58-4bff10d26953"
      }
    }
  }
}
